MI_ENVIRONMENT=development
MI_DATABASE_URL=mysql+pymysql://leapmetrics:URL_ENCODED_PASSWORD@127.0.0.1:3306/leapmetrics?charset=utf8mb4
# Generate a fresh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
MI_SECRET_KEY=
MI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MI_COOKIE_SECURE=false
MI_SESSION_HOURS=8
MI_SESSION_IDLE_MINUTES=30
MI_RESET_MINUTES=30
MI_LOGIN_ATTEMPTS=10
MI_RATE_WINDOW_SECONDS=900
# Compose database provisioning only. Set fresh, different passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

