MI_ENVIRONMENT=development
MI_DATABASE_URL=mysql+pymysql://leapmetrics:URL_ENCODED_PASSWORD@127.0.0.1:3306/leapmetrics?charset=utf8mb4
# Generate a fresh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
MI_SECRET_KEY=
MI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Exact origin(s) used when opening the Docker-hosted app; use the server hostname/origin for access from other machines.
MI_DOCKER_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
MI_COOKIE_SECURE=false
MI_SESSION_HOURS=8
MI_SESSION_IDLE_MINUTES=30
MI_RESET_MINUTES=30
MI_SETUP_LINK_MINUTES=10080
MI_LOGIN_ATTEMPTS=10
MI_RATE_WINDOW_SECONDS=900
# Email is disabled by default. First verify via a test mailbox, then explicitly disable test mode.
MI_MAIL_ENABLED=false
MI_MAIL_TEST_MODE=true
MI_MAIL_TEST_RECIPIENT=
MI_MAIL_FROM_ADDRESS=
MI_MAIL_FROM_NAME=MyCareer
MI_SMTP_HOST=smtp.office365.com
MI_SMTP_PORT=587
MI_SMTP_USERNAME=
MI_SMTP_PASSWORD=
MI_SMTP_STARTTLS=true
MI_PUBLIC_BASE_URL=
# Compose database provisioning only. Set fresh, different passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

