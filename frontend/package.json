{
  "name": "mi-leapmetrics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "typescript": "5.9.3", "vite": "8.3.4", "vitest": "5.0.5", "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.0.0",
    "@testing-library/react": "^16.3.0", "@testing-library/jest-dom": "7.0.1", "@testing-library/user-event": "^14.6.0", "@testing-library/dom": "10.4.2",
    "jsdom": "30.1.3", "eslint": "10.13.0", "@eslint/js": "10.0.1", "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "^7.0.0", "globals": "^16.5.0", "openapi-typescript": "^7.10.0"
  }
}
