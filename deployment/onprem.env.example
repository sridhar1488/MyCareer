# Use fresh, distinct, URL-safe hexadecimal secrets. Never commit the real .env file.
MYSQL_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTERS
MI_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
# Exact public HTTPS origin served by the on-prem reverse proxy, encoded as a JSON array.
MI_ALLOWED_ORIGINS=["https://mycareer.example.local"]
# Optional company SMTP relay. Delivery stays disabled until explicitly configured.
MI_MAIL_ENABLED=false
MI_MAIL_TEST_MODE=true
MI_MAIL_TEST_RECIPIENT=
MI_MAIL_FROM_ADDRESS=
MI_MAIL_FROM_NAME=MyCareer
MI_SMTP_HOST=
MI_SMTP_PORT=587
MI_SMTP_USERNAME=
MI_SMTP_PASSWORD=
MI_SMTP_STARTTLS=true
MI_PUBLIC_BASE_URL=https://mycareer.example.local
MI_SETUP_LINK_MINUTES=1440
