# Use fresh, distinct, URL-safe hexadecimal secrets. Never commit the real .env file.
# First install: create these named volumes before starting Compose.
# Upgrade: set these to the existing volumes shown by `docker volume ls`.
MI_DATABASE_VOLUME=mycareer_database
MI_ATTACHMENTS_VOLUME=mycareer_attachments
# First install defaults. Upgrade: keep the database name/user from the old deployment.
MI_DATABASE_NAME=mycareer
MI_DATABASE_USER=mycareer
MYSQL_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTERS
MI_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
# Exact public HTTPS origin served by the on-prem reverse proxy, encoded as a JSON array.
MI_ALLOWED_ORIGINS=["https://mycareer.example.local"]
# Microsoft 365 authenticated SMTP client submission.
# Keep delivery disabled until a test recipient and the real HTTPS app URL are set.
MI_MAIL_ENABLED=false
MI_MAIL_TEST_MODE=true
MI_MAIL_TEST_RECIPIENT=
MI_MAIL_FROM_ADDRESS=
MI_MAIL_FROM_NAME=MyCareer
MI_SMTP_HOST=smtp.office365.com
MI_SMTP_PORT=587
# The mailbox must have Authenticated SMTP enabled by the Microsoft 365 admin.
MI_SMTP_USERNAME=
MI_SMTP_PASSWORD=
MI_SMTP_STARTTLS=true
MI_PUBLIC_BASE_URL=https://mycareer.example.local
MI_SETUP_LINK_MINUTES=10080
